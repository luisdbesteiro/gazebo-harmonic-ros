<?xml version="1.0"?>
<model>
  <name>Unitree G1 29DoF policy Gazebo plugin control</name>
  <version>1.0</version>
  <sdf version="1.11">model.sdf</sdf>
  <author>
    <name>Local Gazebo Harmonic ROS 2 workspace</name>
  </author>
  <description>
    Gazebo Harmonic SDF variant generated from Unitree g1_29dof_rev_1_0.urdf.
    This free-base variant loads the policy_control Gazebo system plugin,
    which runs the ONNX policy inside Gazebo and publishes targets directly to
    the Gazebo joint position controller topics.
  </description>
</model>
